{
  "name": "cleanplay-console",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "test": "vite build && vitest",
    "test:ci": "vite build && vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx,.mts",
    "lint:fix": "eslint . --ext .ts,.tsx,.mts --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "audit": "bun audit",
    "fe:dev": "vite",
    "fe:serve": "vite preview",
    "be:dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "build": "vite build",
    "dev": "concurrently \"bun run fe:dev\" \"bun run be:dev\"",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "cookie-session": "^2.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.0",
    "redis": "^6.2.1",
    "ua-parser-js": "^2.0.9"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "steamid": "^2.0.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
